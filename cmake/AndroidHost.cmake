# Optional Android runtime; ordinary Android library builds stay dependency-light.
set(UIKIT_ANDROID_BACKEND_SOURCE "" CACHE PATH "Pinned libs-back sources for the Android host")
if(UIKIT_ANDROID_BACKEND_SOURCE)
  if(NOT EXISTS "${UIKIT_ANDROID_BACKEND_SOURCE}/Source/gsc/GSContext.m")
    message(FATAL_ERROR "Invalid UIKIT_ANDROID_BACKEND_SOURCE")
  endif()
  set(back "${UIKIT_ANDROID_BACKEND_SOURCE}")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/android-config")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/android-config/config.h" "/* Android generic graphics state needs no optional backend features. */\n")
  foreach(name GSContext GSGState GSStreamContext GSStreamGState GSFunction externs)
    target_sources(UIKit PRIVATE "${back}/Source/gsc/${name}.m")
  endforeach()
  target_sources(UIKit PRIVATE "${back}/Source/gsc/gscolors.c" "${back}/Source/headless/HeadlessGState.m")
  target_include_directories(UIKit PRIVATE "${back}/Headers" "${CMAKE_CURRENT_BINARY_DIR}/android-config")
  target_compile_definitions(UIKit PRIVATE UIKIT_ANDROID_HOST=1)
  target_link_libraries(UIKit PRIVATE EGL GLESv1_CM log)
  add_library(UIKitCube SHARED Examples/OpenGLExample.m Examples/AndroidCube/Host.m)
  target_compile_options(UIKitCube PRIVATE -fobjc-runtime=${UIKIT_ANDROID_OBJC_RUNTIME} -fblocks -fconstant-string-class=NSConstantString)
  target_include_directories(UIKitCube PRIVATE Headers Source/Android ${GNUSTEP_BASE_INCLUDE_DIR} ${GNUSTEP_GUI_INCLUDE_DIR})
  target_link_libraries(UIKitCube PRIVATE UIKit ${GNUSTEP_GUI_LIBRARY} ${GNUSTEP_BASE_LIBRARY} ${OBJC_LIBRARY} GLESv1_CM log m)
  target_link_options(UIKitCube PRIVATE -Wl,--no-undefined)
  install(TARGETS UIKitCube LIBRARY DESTINATION lib)
endif()
