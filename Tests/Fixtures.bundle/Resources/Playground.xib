<?xml version='1.0' encoding='UTF-8'?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light" />
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504" />
        <capability name="Safe area layout guides" minToolsVersion="9.0" />
        <capability name="System colors in document resources" minToolsVersion="11.0" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="owner" userLabel="File's Owner" customClass="BasicViewController">
            <connections>
                <outlet property="view" destination="root" id="out-view" />
                <outlet property="greetingLabel" destination="label" id="out-label" />
                <outlet property="nameTextField" destination="field" id="out-field" />
                <outlet property="greetButton" destination="button" id="out-button" />
                <outlet property="scrollView" destination="scroll" id="out-scroll" />
                <outlet property="contentStack" destination="stack" id="out-stack" />
                <outlet property="personalizationSwitch" destination="personalization" id="out-personalization" />
                <outlet property="progressSlider" destination="slider" id="out-slider" />
                <outlet property="progressView" destination="progress" id="out-progress" />
                <outlet property="progressLabel" destination="progress-label" id="out-progress-label" />
                <outlet property="fontSizeStepper" destination="stepper" id="out-stepper" />
                <outlet property="fontSizeLabel" destination="font-label" id="out-font-label" />
                <outlet property="greetingStyleControl" destination="style" id="out-style" />
                <outlet property="historyTableView" destination="history" id="out-history" />
                <outlet property="infoButton" destination="info" id="out-info" />
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="first" customClass="UIResponder" />
        <view contentMode="scaleToFill" id="root">
            <rect key="frame" x="0.0" y="0.0" width="393" height="852" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
            <subviews>
                <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="scroll">
                    <rect key="frame" x="0" y="59" width="393" height="759" />
                    <subviews>
                        <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="stack">
                            <rect key="frame" x="24" y="91" width="345" height="132" />
                            <subviews>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Hello, UIKit!" textAlignment="center" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="label">
                                    <rect key="frame" x="0.0" y="0.0" width="345" height="24" />
                                    <fontDescription key="fontDescription" type="system" pointSize="20" />
                                </label>
                                <textField opaque="NO" contentMode="scaleToFill" borderStyle="roundedRect" placeholder="Enter your name" translatesAutoresizingMaskIntoConstraints="NO" id="field">
                                    <rect key="frame" x="0.0" y="40" width="345" height="34" />
                                    <fontDescription key="fontDescription" type="system" pointSize="17" />
                                    <textInputTraits key="textInputTraits" autocapitalizationType="words" returnKeyType="done" />
                                </textField>
                                <button opaque="NO" contentMode="scaleToFill" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="button">
                                    <rect key="frame" x="0.0" y="90" width="345" height="44" />
                                    <constraints>
                                        <constraint firstAttribute="height" constant="44" id="button-height" />
                                    </constraints>
                                    <state key="normal" title="Say Hello" />
                                    <connections>
                                        <action selector="greet:" destination="owner" eventType="touchUpInside" id="action-greet" />
                                    </connections>
                                </button>
                                <stackView axis="horizontal" alignment="center" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="switch-row">
                                    <subviews>
                                        <label opaque="NO" text="Use name in greeting" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="switch-label">
                                            <fontDescription key="fontDescription" type="system" pointSize="17" />
                                        </label>
                                        <switch on="YES" translatesAutoresizingMaskIntoConstraints="NO" id="personalization">
                                            <connections>
                                                <action selector="personalizationChanged:" destination="owner" eventType="valueChanged" id="action-personalization" />
                                            </connections>
                                        </switch>
                                    </subviews>
                                </stackView>
                                <segmentedControl selectedSegmentIndex="0" translatesAutoresizingMaskIntoConstraints="NO" id="style">
                                    <segments>
                                        <segment title="Hello" />
                                        <segment title="Welcome" />
                                    </segments>
                                    <connections>
                                        <action selector="greetingStyleChanged:" destination="owner" eventType="valueChanged" id="action-style" />
                                    </connections>
                                </segmentedControl>
                                <label opaque="NO" text="Progress: 25%" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="progress-label">
                                    <fontDescription key="fontDescription" type="system" pointSize="17" />
                                </label>
                                <slider value="0.25" minValue="0" maxValue="1" translatesAutoresizingMaskIntoConstraints="NO" id="slider">
                                    <connections>
                                        <action selector="progressChanged:" destination="owner" eventType="valueChanged" id="action-slider" />
                                    </connections>
                                </slider>
                                <progressView progress="0.25" translatesAutoresizingMaskIntoConstraints="NO" id="progress" />
                                <stackView axis="horizontal" alignment="center" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="font-row">
                                    <subviews>
                                        <label opaque="NO" text="Greeting font: 20 pt" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="font-label">
                                            <fontDescription key="fontDescription" type="system" pointSize="17" />
                                        </label>
                                        <stepper value="20" minimumValue="16" maximumValue="32" stepValue="2" translatesAutoresizingMaskIntoConstraints="NO" id="stepper">
                                            <connections>
                                                <action selector="fontSizeChanged:" destination="owner" eventType="valueChanged" id="action-stepper" />
                                            </connections>
                                        </stepper>
                                    </subviews>
                                </stackView>
                                <label opaque="NO" text="Greeting history (tap for details)" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="history-label">
                                    <fontDescription key="fontDescription" type="system" pointSize="17" />
                                </label>
                                <tableView clipsSubviews="YES" alwaysBounceVertical="YES" style="plain" separatorStyle="default" rowHeight="44" translatesAutoresizingMaskIntoConstraints="NO" id="history">
                                    <constraints>
                                        <constraint firstAttribute="height" constant="176" id="history-height" />
                                    </constraints>
                                    <connections>
                                        <outlet property="dataSource" destination="owner" id="history-source" />
                                        <outlet property="delegate" destination="owner" id="history-delegate" />
                                    </connections>
                                </tableView>
                                <button buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="info">
                                    <constraints>
                                        <constraint firstAttribute="height" constant="44" id="info-height" />
                                    </constraints>
                                    <state key="normal" title="About this playground" />
                                    <connections>
                                        <action selector="showInfo:" destination="owner" eventType="touchUpInside" id="action-info" />
                                    </connections>
                                </button>
                            </subviews>
                        </stackView>
                    </subviews>
                    <viewLayoutGuide key="contentLayoutGuide" id="scroll-content" />
                    <viewLayoutGuide key="frameLayoutGuide" id="scroll-frame" />
                    <constraints>
                        <constraint firstItem="stack" firstAttribute="leading" secondItem="scroll-content" secondAttribute="leading" constant="24" id="scroll-constraint-0" />
                        <constraint firstItem="scroll-content" firstAttribute="trailing" secondItem="stack" secondAttribute="trailing" constant="24" id="scroll-constraint-1" />
                        <constraint firstItem="stack" firstAttribute="top" secondItem="scroll-content" secondAttribute="top" constant="32" id="scroll-constraint-2" />
                        <constraint firstItem="scroll-content" firstAttribute="bottom" secondItem="stack" secondAttribute="bottom" constant="24" id="scroll-constraint-3" />
                        <constraint firstItem="stack" firstAttribute="width" secondItem="scroll-frame" secondAttribute="width" constant="-48" id="scroll-constraint-4" />
                    </constraints>
                </scrollView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="safe" />
            <color key="backgroundColor" systemColor="systemBackgroundColor" />
            <constraints>
                <constraint firstItem="scroll" firstAttribute="leading" secondItem="safe" secondAttribute="leading" id="scroll-leading" />
                <constraint firstItem="scroll" firstAttribute="trailing" secondItem="safe" secondAttribute="trailing" id="scroll-trailing" />
                <constraint firstItem="scroll" firstAttribute="top" secondItem="safe" secondAttribute="top" id="scroll-top" />
                <constraint firstItem="scroll" firstAttribute="bottom" secondItem="safe" secondAttribute="bottom" id="scroll-bottom" />
            </constraints>
        </view>
    </objects>
    <resources>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
        </systemColor>
    </resources>
</document>